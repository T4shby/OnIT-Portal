APP_NAME="On IT Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Admin activity_logs retention (days). Default 90. Do not skip 127.0.0.1 rows.
ACTIVITY_LOG_RETAIN_DAYS=90

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onit_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave blank unless you intentionally scope cookie to a parent domain
SESSION_DOMAIN=
# HTTPS-only session cookie. Blank = true when APP_ENV=production, false otherwise
# (config/session.php). Set true in production anyway; false only for local HTTP dev.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Optional. Seconds before a reserved job is treated as abandoned and handed to
# another worker. Default 900 (config/queue.php). Must stay above the longest job
# $timeout (600s) or long Entra/SCIM jobs run twice in parallel.
# DB_QUEUE_RETRY_AFTER=900

CACHE_STORE=database
CACHE_PREFIX=onit_portal

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
MICROSOFT_REDIRECT_URI=http://127.0.0.1:8000/auth/microsoft/callback
# Production defaults to true (session often lost behind Plesk/nginx). Set false to force session state validation.
MICROSOFT_OAUTH_STATELESS=

SUPEROPS_API_TOKEN=
SUPEROPS_SUBDOMAIN=onitltd
SUPEROPS_REGION=us
# Optional - defaults to same host as requester portal (portal.onit.ltd)
# SUPEROPS_TECHNICIAN_PORTAL_URL=
SUPEROPS_PORTAL_URL=https://app.superops.ai
# Technician login path - SuperOps SPA route (MSP console)
SUPEROPS_TECHNICIAN_LOGIN_PATH="/#/technician/login"
# Optional - defaults to https://{SUPEROPS_SUBDOMAIN}.superops.ai
SUPEROPS_REQUESTER_PORTAL_URL=
# Requester login path - SuperOps SPA route is /requester/login (not /login/requester)
SUPEROPS_REQUESTER_LOGIN_PATH="/#/requester/login"
# Pass portal user email to SuperOps/Microsoft (login_hint query param)
SUPEROPS_LOGIN_HINT_ENABLED=true
# Requester Client SSO is configured per customer in SuperOps and customer Entra.
# The portal launch URL remains the shared requester portal.
SUPEROPS_SSO_URL=
SUPEROPS_SSO_ENABLED=true
SUPEROPS_AUTO_OPEN_AFTER_LOGIN=false
# createTicket requestType (mandatory on On IT MSP; default Incident)
SUPEROPS_DEFAULT_REQUEST_TYPE=Incident

# Contact Support hub (client users) - Service Desk details
# ONIT_SUPPORT_PHONE=03300 945 946
# ONIT_SUPPORT_EMAIL=service.desk@onit.ltd
# ONIT_SUPPORT_HOURS="Monday-Friday, 09:00-17:00"
# ONIT_SUPPORT_HOURS_TZ=UK
# Pipe-separated address lines:
# ONIT_SUPPORT_ADDRESS="Unit G, Wheatley Park|Mirfield|WF14 8HE"

# Huntress - Client Admin security metrics (Phase 3). Leave disabled until keys are set.
HUNTRESS_ENABLED=false
HUNTRESS_API_KEY=
HUNTRESS_API_SECRET=
HUNTRESS_CONSOLE_BASE_URL=https://on-it-technology-partners.huntress.io

# Dropsuite / NinjaOne SaaS Backup - Client Admin backup metrics (Phase 4).
DROPSUITE_ENABLED=false
DROPSUITE_API_URL=https://dropsuite.uk/api
DROPSUITE_RESELLER_TOKEN=
DROPSUITE_AUTH_TOKEN=

# Pax8 - must use app.pax8.com for Enterprise SSO (not mycommandconsole.com). See Brain/Pax8EnterpriseSsoSetup.md
PAX8_PORTAL_URL=https://app.pax8.com
PAX8_PARTNER_PORTAL_URL=https://app.pax8.com
PAX8_PARTNER_LOGIN_PATH=/login
PAX8_COMPANY_URL_TEMPLATE=https://app.pax8.com/companies/{companyId}
PAX8_LOGIN_HINT_ENABLED=true
PAX8_SSO_ENABLED=true
MICROSOFT_365_PORTAL_URL=https://admin.microsoft.com
KNOWLEDGE_BASE_URL=
BILLING_PORTAL_URL=

SUPER_ADMIN_EMAIL=admin@onit.example

# Entra group sync (Phase 2) - see Brain/EntraGroupSync.md
ENTRA_SYNC_ENABLED=false
ENTRA_SYNC_MAINTAIN_SUPEROPS_GROUP=true
# Optional separate app registration for Graph application permissions
# ENTRA_SYNC_CLIENT_ID=
# ENTRA_SYNC_CLIENT_SECRET=
# Safety valve: abort a sync that would deactivate more than this share of a
# client's active synced users (once at least MIN_USERS would go).
# ENTRA_SYNC_MAX_DEACTIVATION_RATIO=0.5
# ENTRA_SYNC_MAX_DEACTIVATION_MIN_USERS=5
# Hours a Connect Microsoft / Re-consent (admin consent) link stays valid.
# Default 24, allowed 1-336. A fresh link is minted on every Edit Client load.
# ADMIN_CONSENT_LINK_TTL_HOURS=24
# Adaptive auto-refresh timing is NOT configured in .env.
# Super Admin → Staff Admin → Integration Health → Auto-refresh timing (settings table).
